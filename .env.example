# Machine-specific harness settings. Copy to .env (gitignored) and uncomment
# what this machine needs. Lines are read as KEY=VALUE and never executed; a
# variable already set in the environment wins over this file.

# The Arc audit service checkout, when it is not services/harness-audit here.
# HARNESS_AUDIT_ROOT=/absolute/path/to/harness-audit

# macOS launchd label for the audit service (default local.harness.audit).
# Install retires any other launchd agent that runs this checkout.
# HARNESS_AUDIT_LAUNCHD_LABEL=local.harness.audit
