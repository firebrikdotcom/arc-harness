 "flows": [
  {
   "id": "connect",
   "title": "Connect to a server",
   "sub": "from tap to a live Herdr session",
   "steps": [
    [
     "user",
     "compose"
    ],
    [
     "compose",
     "app"
    ],
    [
     "app",
     "session"
    ],
    [
     "session",
     "keystore"
    ],
    [
     "session",
     "shell"
    ],
    [
     "shell",
     "herdr"
    ],
    [
     "session",
     "protocol"
    ],
    [
     "protocol",
     "herdr"
    ],
    [
     "protocol",
     "state"
    ]
   ],
   "text": [
    "You tap a saved server.",
    "AppViewModel asks the session to connect.",
    "JSch checks the pinned host key and signs with the Keystore key.",
    "An exec channel starts herdr in a login shell with a PTY.",
    "Herdr's Unix socket is forwarded; the client speaks JSON-RPC.",
    "Events fold into the snapshot the workspace screen draws."
   ]
  },
  {
   "id": "type",
   "title": "Type in a terminal",
   "sub": "keyboard to remote PTY and back",
   "steps": [
    [
     "user",
     "compose"
    ],
    [
     "compose",
     "terminal"
    ],
    [
     "terminal",
     "keys"
    ],
    [
     "terminal",
     "engine"
    ],
    [
     "engine",
     "shell"
    ]
   ],
   "text": [
    "The hidden editable receives IME input and accessory keys.",
    "Keys are mapped in the core (modifiers, hold repeat).",
    "Bytes go out over the SSH channel; output returns to the Termux emulator, which draws rows."
   ]
  },
  {
   "id": "approve",
   "title": "Approve an agent",
   "sub": "from a notification, app closed",
   "steps": [
    [
     "herdr",
     "protocol"
    ],
    [
     "protocol",
     "state"
    ],
    [
     "app",
     "notify"
    ],
    [
     "notify",
     "agent"
    ],
    [
     "notify",
     "android"
    ],
    [
     "app",
     "android"
    ],
    [
     "protocol",
     "herdr"
    ]
   ],
   "text": [
    "Herdr pushes an agent-blocked event.",
    "The reducer updates the snapshot; the notification plan decides what to post.",
    "Android shows it; the foreground service keeps the session alive.",
    "Approve sends the answer back to Herdr over the same session."
   ]
  },
  {
   "id": "sync",
   "title": "Sync servers",
   "sub": "optional, via Google Drive",
   "steps": [
    [
     "app",
     "sync"
    ],
    [
     "sync",
     "google"
    ],
    [
     "sync",
     "stores"
    ]
   ],
   "text": [
    "After sign-in, the app reads its Drive app-data file.",
    "Servers and host-key pins merge into local stores.",
    "The private key never leaves the device."
   ]
  }
 ]
