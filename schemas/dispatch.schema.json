{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded role dispatch plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["workers"],
  "properties": {
    "request_id": {"type": "string"},
    "rationale": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["task_size", "strategy", "reason", "model_fit", "latency_tradeoff"],
      "properties": {
        "task_size": {"enum": ["trivial", "substantial"]},
        "strategy": {"enum": ["main_only", "delegate"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "model_fit": {"type": "string", "minLength": 1, "maxLength": 1000},
        "latency_tradeoff": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "workers": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "responsibility", "acceptance", "owned_paths", "context", "dependencies", "access", "profiles"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "role": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "access": {"enum": ["read", "edit"]},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "owned_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "profiles": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"workers": {"maxItems": 0}}}, "then": {"required": ["rationale", "acceptance"], "properties": {"assessment": {"properties": {"strategy": {"const": "main_only"}}}}}},
    {"if": {"properties": {"workers": {"minItems": 1}}}, "then": {"required": ["assessment"], "properties": {"assessment": {"properties": {"task_size": {"const": "substantial"}, "strategy": {"const": "delegate"}}}}}}
  ]
}
