{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/action.schema.json",
  "title": "Harness proposed action",
  "description": "Contract for an action the model proposes. The harness validates this shape. It does not execute the action.",
  "oneOf": [
    { "$ref": "#/$defs/run_command" },
    { "$ref": "#/$defs/write_file" }
  ],
  "$defs": {
    "run_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "command"],
      "properties": {
        "version": { "const": 1 },
        "type": { "const": "run_command" },
        "reason": { "type": "string" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "write_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "path"],
      "properties": {
        "version": { "const": 1 },
        "type": { "const": "write_file" },
        "reason": { "type": "string" },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path. Must not be absolute or contain .. components."
        },
        "content": { "type": "string" }
      }
    }
  }
}
