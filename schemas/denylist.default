# Harness default denylist. A project replaces it entirely with a .harness-denylist file at its root.
# Format: "command <regex>" matches the whole shell command string; "path <regex>" matches a write
# target, relative to the project root when inside it and absolute otherwise; "inline <regex>"
# matches inline interpreter code (python -c, node -e, ...) and commands that cannot be parsed.
# scripts/permit.py parses each shell command and checks every file it would write (redirections,
# tee, cp, mv, rm, sed -i, dd of=, ...) against the path rules, so reading or naming a protected
# file is allowed and only writing it is denied. Regexes must be valid in both Python and
# JavaScript. Rules are deny-only: anything not listed is allowed.

# Destroying root, home, the parent or current directory, or the git directory
command (^|[;&|(]\s*)rm\s+(-[A-Za-z]+\s+)*(-[A-Za-z]*[rRf][A-Za-z]*\s+)(-[A-Za-z]+\s+)*(/\*?|~/?|\$HOME/?|\.\.|\.)(\s|$|[;&|)])
command (^|[;&|(]\s*)rm\s+(-[A-Za-z]+\s+)*(-[A-Za-z]*[rR][A-Za-z]*\s+)(-[A-Za-z]+\s+)*(\./)?\.git(/|\s|$|[;&|)])
command \bfind\s+(/|~)\s.*\s-delete\b
command \b(mkfs|fdisk|diskutil\s+erase|dd\s+if=)
command >\s*/dev/(sd|disk|nvme|hd)
command \b(shutdown|reboot|halt|poweroff)\b

# Privilege escalation and piping downloads into an interpreter
command (^|[;&|(]\s*)(sudo|doas|su)\b
command \|\s*(sudo\s+)?(ba|z|da|k|c|tc)?sh\b
command \b(curl|wget)\b.*\|\s*(python3?|perl|node|ruby)\b

# History-rewriting or destructive git. Explicit leases compare the remote ref
# with the expected full object ID; implicit leases and unconditional force stay denied.
command \bgit\s+push\b.*(\s--force(?!-with-lease=[^\s:]+:(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?:\s|$))\b|\s-f\b|\s\+[A-Za-z])
command \bgit\s+(reset\s+--hard|clean\s+-[A-Za-z]*[fFxX]|checkout\s+--\s+\.|restore\s+(--staged\s+)?\.\s*$)
command \bgit\s+(branch\s+-D|filter-branch|filter-repo|update-ref\s+-d)\b
command \bgit\s+config\b.*\bcore\.hooksPath\b

# Widening what jevgrep (jg) uploads to its retrieval provider; use scripts/jg.sh
command \bjg\b.*\s--(include-sensitive|no-ignore)\b

# Publishing to the outside world
command \b(npm|pnpm|yarn)\s+publish\b
command \b(cargo|gem)\s+(publish|push)\b
command \btwine\s+upload\b
command \bgh\s+(release\s+create|repo\s+delete)\b

# Loosening permissions, disabling or retuning the guard, or human-only decisions
command \bchmod\s+(-R\s+)?[0-7]*777\b
command (^|[\s;&|(])(export\s+|env\s+)?HARNESS_(HOOK_DISABLE|BUDGET_[A-Z_]+|RUN_IDLE_HOURS|RETAIN_RUNS|HOME|DB_ROOT|REQUIRED_CHECKS|REVIEWER_CMD|REVIEW_BASE)=
command knowledge-trust\.sh\s+approve\b
command (^|[\s;&|(/])harness\s+(abort|failure|review\s+submit)\b

# Inline interpreter code that writes to the guard, its rules, or its state
inline (scripts/hooks/|scripts/permit\.(sh|py)|scripts/guard-version|schemas/denylist\.default|\.harness-denylist|\.harness-db|\.claude/(settings(\.local)?\.json|CLAUDE\.md))[\s\S]*(['"][wax]\+?['"]|write_text|write_bytes|\.write\(|writeFile|appendFile|unlink|os\.remove|rename|chmod|shutil\.|rmtree|truncate|subprocess|system\()
inline (open\([^)]*['"][wax]|write_text|write_bytes|\.write\(|writeFile|appendFile|unlink|os\.remove|rename|chmod|shutil\.|rmtree|truncate|subprocess|system\()[\s\S]*(scripts/hooks/|scripts/permit\.(sh|py)|scripts/guard-version|schemas/denylist\.default|\.harness-denylist|\.harness-db|\.claude/(settings(\.local)?\.json|CLAUDE\.md))

# Write targets: git internals, secrets, the guard itself
path (^|/)\.git(/|$)
path (^|/)\.env$
path (^|/)\.env\.(?!example$)
path (^|/)id_(rsa|dsa|ecdsa|ed25519)$
path \.(pem|key|p12|pfx)$
path (^|/)\.(ssh|gnupg|aws)/
path ^/etc/
path (^|/)\.claude/(settings(\.local)?\.json|CLAUDE\.md)$
path ^scripts/hooks/
path ^scripts/permit\.(sh|py)$
path ^scripts/guard-version$
path ^scripts/knowledge-trust\.sh$
path ^schemas/denylist\.default$
path ^\.harness-denylist$
# The harness database (runs, contracts, failure counts, gate records) is written
# only by the harness scripts, never by a tool call.
path (^|/)\.harness-db(/|$)
