{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Behavior verification definitions",
  "description": "Manifest definitions. Report format is deferred until run ownership is implemented.",
  "type": "object",
  "required": ["version", "enabled", "guide", "index", "features"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "enabled": {"type": "boolean"},
    "guide": {"type": "string", "minLength": 1},
    "index": {"type": "string", "minLength": 1},
    "features": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "document", "references"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "document": {"type": "string", "minLength": 1},
        "references": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["path", "id"],
          "properties": {"path": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1, "maxLength": 128}}
        }}
      }
    }}
  }
}
