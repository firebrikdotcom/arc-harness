.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
